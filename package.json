{
  "name": "typo-hunter",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && pnpm run build:api && vite build",
    "preview": "vite preview",
    "deploy": "vercel --prod",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:api": "esbuild server/vercel.ts --bundle --platform=node --format=esm --target=node20 --minify-syntax --legal-comments=none --outfile=api/index.js --log-level=warning"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@types/qrcode": "^1.5.6",
    "idb": "^7.1.1",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "all-the-cities": "^3.1.0",
    "an-array-of-english-words": "2.0.0",
    "an-array-of-french-words": "^2.0.0",
    "an-array-of-spanish-words": "^2.0.0",
    "autoprefixer": "^10.4.14",
    "esbuild": "0.18.20",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.0.2",
    "vercel": "^65.11.0",
    "vite": "^4.3.9",
    "vitest": "^0.34.6",
    "wordlist-english": "^1.2.1"
  }
}
